{
  "name": "@local/dsh-databricks-mlflow-tracing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Traces every DeepSeek Harness conversation turn into MLflow through a Databricks profile.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "databricks",
    "mlflow",
    "tracing",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcheng004/dsh-databricks-mlflow-tracing.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@databricks/sdk-experimental": "0.15.0",
    "@opentelemetry/api": "^1.9.0",
    "mlflow-tracing": "0.1.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
